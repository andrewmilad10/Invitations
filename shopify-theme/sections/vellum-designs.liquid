{%- assign base = section.settings.screens_base -%}
<section class="v v-designs" id="designs">
  <div class="v-wrap">
    <div class="v-designs__head">
      <p class="v-kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="v-h">{{ section.settings.heading | escape }}</h2>
      <p class="v-lead">{{ section.settings.lead | escape }}</p>
    </div>
    <div class="v-chips" role="group" aria-label="Filter designs" data-v-chips>
      <button type="button" class="v-chip" data-mood="all" aria-pressed="true">All designs</button>
      <button type="button" class="v-chip" data-mood="floral" aria-pressed="false">Floral &amp; romantic</button>
      <button type="button" class="v-chip" data-mood="classic" aria-pressed="false">Classic &amp; foil</button>
      <button type="button" class="v-chip" data-mood="nights" aria-pressed="false">Egyptian nights</button>
    </div>
    <div class="v-grid" data-v-grid>
      {%- liquid
        assign lim = section.settings.limit
        if lim == 0
          assign lim = 100
        endif
      -%}
      {%- for block in section.blocks limit: lim -%}
        {%- liquid
          assign id = block.settings.template_id | strip
          assign p = all_products[id]
          assign card = 'card-' | append: id | append: '.webp'
          assign demo = base | append: '/embed/' | append: id
        -%}
        {%- if p.id -%}
        <article class="v-card" data-mood="{{ block.settings.mood }}" {{ block.shopify_attributes }}>
          <a class="v-card__pic" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
            <img src="{{ card | asset_url }}" alt="" width="640" height="640" loading="lazy">
          </a>
          <div class="v-card__body">
            <h3 class="v-card__name"><a href="{{ p.url }}">{{ block.settings.name | escape }}</a></h3>
            <p class="v-card__ar v-ar" lang="ar">{{ block.settings.name_ar | escape }}</p>
            <p class="v-card__tag">{{ block.settings.tagline | escape }}</p>
            <p class="v-card__price">{{ p.price | money }}</p>
            <a class="v-card__try" href="{{ p.url }}">Choose this design</a>
          </div>
        </article>
        {%- else -%}
        <article class="v-card" data-mood="{{ block.settings.mood }}" {{ block.shopify_attributes }}>
          <button type="button" class="v-card__pic" data-v-demo="{{ demo }}" data-name="{{ block.settings.name | escape }}" aria-label="Try the {{ block.settings.name | escape }} demo">
            <img src="{{ card | asset_url }}" alt="" width="640" height="640" loading="lazy">
          </button>
          <div class="v-card__body">
            <h3 class="v-card__name">{{ block.settings.name | escape }}</h3>
            <p class="v-card__ar v-ar" lang="ar">{{ block.settings.name_ar | escape }}</p>
            <p class="v-card__tag">{{ block.settings.tagline | escape }}</p>
            <button type="button" class="v-card__try" data-v-demo="{{ demo }}" data-name="{{ block.settings.name | escape }}">Try demo</button>
          </div>
        </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.limit > 0 and section.blocks.size > section.settings.limit and section.settings.more_label != blank -%}
      <p class="v-more"><a class="v-btn v-btn--line" href="{{ section.settings.more_link | default: '/collections/all' }}">{{ section.settings.more_label | escape }}</a></p>
    {%- endif -%}
  </div>
  <dialog class="v-demo" data-v-dialog aria-label="Design demo">
    <div class="v-demo__in">
      <div class="v-demo__bar">
        <p class="v-demo__name" data-v-dname></p>
        <button type="button" class="v-demo__x" data-v-dclose aria-label="Close">✕</button>
      </div>
      <div class="v-demo__phone"><iframe data-v-dframe title="Design demo" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin"></iframe></div>
    </div>
  </dialog>
</section>

{% schema %}
{
  "name": "Vellum designs",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your design" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Every design opens like real stationery. Tap one to see it with your own names." },
    { "type": "text", "id": "screens_base", "label": "Vellum address", "default": "https://invitations-sooty.vercel.app" },
    { "type": "range", "id": "limit", "label": "Designs to show (0 = all)", "min": 0, "max": 30, "step": 1, "default": 0 },
    { "type": "text", "id": "more_label", "label": "Show more button", "default": "See all designs" },
    { "type": "url", "id": "more_link", "label": "Show more link" }
  ],
  "blocks": [
    { "type": "design", "name": "Design", "settings": [
      { "type": "text", "id": "template_id", "label": "Template id (same as the product handle)" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "name_ar", "label": "Arabic name" },
      { "type": "select", "id": "mood", "label": "Mood", "default": "floral", "options": [
        { "value": "floral", "label": "Floral & romantic" },
        { "value": "classic", "label": "Classic & foil" },
        { "value": "nights", "label": "Egyptian nights" }
      ] },
      { "type": "textarea", "id": "tagline", "label": "Tagline" }
    ] }
  ],
  "presets": [{ "name": "Vellum designs" }]
}
{% endschema %}
