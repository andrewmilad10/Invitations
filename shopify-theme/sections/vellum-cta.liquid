<section class="v v-cta">
  <h2 class="v-h">{{ section.settings.heading | escape }}</h2>
  {%- if section.settings.heading_ar != blank -%}<p class="v-ar" lang="ar">{{ section.settings.heading_ar | escape }}</p>{%- endif -%}
  <p class="v-lead">{{ section.settings.lead | escape }}</p>
  <p style="margin:2rem 0 0"><a class="v-btn v-btn--light" href="{{ section.settings.link | default: '#designs' }}">{{ section.settings.label | escape }}</a></p>
</section>

{% schema %}
{
  "name": "Vellum final call",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready when you are" },
    { "type": "text", "id": "heading_ar", "label": "Arabic line", "default": "ابدؤوا دعوتكم اليوم" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Choose a design, see it with your names, and we'll have it ready within a day of your photos." },
    { "type": "text", "id": "label", "label": "Button", "default": "Choose your design" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Vellum final call" }]
}
{% endschema %}
