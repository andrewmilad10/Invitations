# ─────────────────────────────────────────────────────────────
# Vellum — environment variables
# Copy to .env.local for development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase project URL.
# Local: printed by `npx supabase start` (usually http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (formerly "anon" key). Safe to expose to the browser:
# every table is protected by Row Level Security.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted for older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of this app. Used for absolute Open Graph URLs,
# share links and auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets ─────────────────────────────────────
# Not used in Phase 1. If a future feature needs the service-role / secret key,
# it must be a server-only variable (no NEXT_PUBLIC_ prefix) and only read in
# server code. NEVER expose it to the browser.
# SUPABASE_SECRET_KEY=

# Local only: lets /templates/<id>/preview show templates marked hidden (e.g. ones waiting for licensed media). Never set in production.
# SHOW_HIDDEN_TEMPLATES=1

# ── Payments (shown to couples after they order) ───────────
# Where couples send the 1,000 EGP. Leave any of them empty to hide it;
# with none set, couples are told you'll message them on WhatsApp.
# Server-only (no NEXT_PUBLIC_): read when the publish window opens.
# PAY_INSTAPAY=yourname@instapay
# PAY_WALLET=01000000000
# PAY_WHATSAPP=201000000000

# ── Bot check (Cloudflare Turnstile) ───────────────────────
# Free at dash.cloudflare.com → Turnstile → Add widget (your domain).
# 1) Put the SECRET key in Supabase → Authentication → Attack Protection →
#    "Enable Captcha protection" (provider: Turnstile).
# 2) Put the SITE key here (public by design) and redeploy.
# Set both together: with only the Supabase side on, logins fail.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Admin alerts (optional) ────────────────────────────────
# A Discord/Slack incoming webhook, or a Telegram bot URL
# (https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>).
# Gets a short message on payments, refunds, team changes and invitations
# turned off. Server-only; never shown to the browser.
# ALERT_WEBHOOK_URL=
