# ─────────────────────────────────────────────────────────────
# Vellum — environment variables
# Copy to .env.local for development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase project URL.
# Local: printed by `npx supabase start` (usually http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (formerly "anon" key). Safe to expose to the browser:
# every table is protected by Row Level Security.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted for older projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of this app. Used for absolute Open Graph URLs,
# share links and auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets ─────────────────────────────────────
# Not used in Phase 1. If a future feature needs the service-role / secret key,
# it must be a server-only variable (no NEXT_PUBLIC_ prefix) and only read in
# server code. NEVER expose it to the browser.
# SUPABASE_SECRET_KEY=
